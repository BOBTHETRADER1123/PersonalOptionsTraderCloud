# Copy this file to .env. Paper-only order handling is enforced in code.
APP_SECRET=replace-with-a-long-random-secret
APP_PASSWORD=change-this-before-sharing-the-app
# Optional production form (pbkdf2_sha256$salt$hex_digest); takes precedence over APP_PASSWORD.
APP_PASSWORD_HASH=
COOKIE_SECURE=false
# For Vercel, add its exact production origin here after creating the project.
CORS_ORIGINS=
DATABASE_URL=sqlite:///./data/options_trader.db
DATA_DIR=./OptionsTraderData
HOST=127.0.0.1
PORT=8000
QUOTE_STALE_SECONDS=5
CHARGE_PER_ORDER=20
SLIPPAGE_POINTS=0

# Optional read-only market-data credentials. Keep them on the backend.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
FIVEPAISA_APP_KEY=
FIVEPAISA_CLIENT_CODE=
FIVEPAISA_ACCESS_TOKEN=

# Reserved for a future live-order release. No live order endpoint exists here.
LIVE_TRADING_ENABLED=false
FEED_UNDERLYINGS=NIFTY,BANKNIFTY,SENSEX,GOLD,GOLDM,GOLDPETAL,SILVER,SILVERM,SILVERMIC,CRUDEOIL,CRUDEOILM,NATURALGAS,NATGASMINI,COPPER,ZINC,ALUMINIUM,LEAD,NICKEL
